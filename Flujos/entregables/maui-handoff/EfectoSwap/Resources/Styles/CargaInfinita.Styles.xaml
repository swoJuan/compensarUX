<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Estilos del control reutilizable CargaInfinitaView (carga infinita). CÓDIGO DE REFERENCIA UX, NO PRODUCTIVO. No compilado.
  No define colores ni medidas del sistema de diseño: los toma por clave de Compensar.Colors.xaml / Compensar.Sizes.xaml.
  Orden en App.xaml → MergedDictionaries:
    1. Compensar.Colors.xaml  2. Compensar.Sizes.xaml  3. CargaInfinita.Styles.xaml (este)  4. EfectoSwap.Styles.xaml
  Fuentes: RobotoRegular, RobotoMedium, RobotoBold. Figma: sección Swap 8658:24679 (reposo 8655:24380, cargando 8657:139,
  fin 8908:24622, error 8923:25318, vacío 8954:26680, skeleton 8954:26839).
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Medidas locales del control (sin token en Compensar.Sizes.xaml) -->
    <x:Double x:Key="CargaInfinitaAltoBoton">48</x:Double>
    <x:Double x:Key="CargaInfinitaAnchoBoton">189</x:Double>

    <!-- ═══ Alerta de error (Figma 8923:25690 «mp alert»: borde 1, radio 12, padding 16, gap 8, icono 32, título Bold 16/1.3, cuerpo Regular 16/1.3, sin botón interno) ═══ -->
    <Style x:Key="CargaInfinitaAlertaError" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource Spacing16px}" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource UseStateErrorBorder}, Dark={StaticResource UseStateErrorBorder_Dark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource UseStateErrorBg}, Dark={StaticResource UseStateErrorBg_Dark}}" />
    </Style>
    <Style x:Key="CargaInfinitaAlertaErrorTitulo" TargetType="Label">
        <Setter Property="FontFamily" Value="RobotoBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="1.3" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UseStateErrorText}, Dark={StaticResource UseStateErrorText_Dark}}" />
    </Style>
    <Style x:Key="CargaInfinitaAlertaErrorCuerpo" TargetType="Label">
        <Setter Property="FontFamily" Value="RobotoRegular" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="1.3" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UseStateErrorText}, Dark={StaticResource UseStateErrorText_Dark}}" />
    </Style>
    <!-- ═══ Pie del listado ═══ -->
    <Style x:Key="CargaInfinitaPieTexto" TargetType="Label">
        <Setter Property="FontFamily" Value="RobotoRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="1.5" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UseTextPrimary}, Dark={StaticResource UseTextPrimary_Dark}}" />
    </Style>
    <Style x:Key="CargaInfinitaPieContador" TargetType="Label" BasedOn="{StaticResource CargaInfinitaPieTexto}">
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UseTextTertiary}, Dark={StaticResource UseTextTertiary_Dark}}" />
    </Style>
    <!-- Indicador de swipe: barra 36×4 al 40 % de opacidad (Figma 8657:135) -->
    <Style x:Key="CargaInfinitaIndicadorSwipe" TargetType="BoxView">
        <Setter Property="WidthRequest" Value="36" />
        <Setter Property="HeightRequest" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Opacity" Value="0.4" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource UseTextTertiary}, Dark={StaticResource UseTextTertiary_Dark}}" />
    </Style>
    <!-- Spinner: el de Figma es gris #D9D9D9 de bajo contraste (divergencia); se usa el color primario como mp-loading del DS -->
    <Style x:Key="CargaInfinitaCargando" TargetType="ActivityIndicator">
        <Setter Property="HeightRequest" Value="32" />
        <Setter Property="WidthRequest" Value="32" />
        <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource UsePrimaryDefault}, Dark={StaticResource UsePrimaryDefault_Dark}}" />
    </Style>
    <Style x:Key="CargaInfinitaBotonTerciario" TargetType="Button">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="MinimumHeightRequest" Value="{StaticResource CargaInfinitaAltoBoton}" />
        <Setter Property="HeightRequest" Value="{StaticResource CargaInfinitaAltoBoton}" />
        <Setter Property="WidthRequest" Value="{StaticResource CargaInfinitaAnchoBoton}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontFamily" Value="RobotoBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="CharacterSpacing" Value="0.352" />
        <Setter Property="TextTransform" Value="None" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UsePrimaryDefault}, Dark={StaticResource UsePrimaryDefault_Dark}}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UsePrimaryDefault}, Dark={StaticResource UsePrimaryDefault_Dark}}" />
                            <Setter Property="BackgroundColor" Value="Transparent" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UsePrimaryHover}, Dark={StaticResource UsePrimaryHover_Dark}}" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- ═══ Primera carga: skeleton (Figma 8954:26839). Barras use/border/subtle, radio 6 (alto 12; el chip usa radio 16 en la página). ═══ -->
    <Style x:Key="CargaInfinitaEsqueletoBarra" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 6" />
        <Setter Property="HeightRequest" Value="12" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource UseBorderSubtle}, Dark={StaticResource UseBorderSubtle_Dark}}" />
    </Style>

    <!-- ═══ Vacío (Figma 8954:26680 «Empty state»: tarjeta blanca radio 16, padding 40/24, gap 16, icono 96, título Bold 18, descripción 14 en tertiary, centrado) ═══ -->
    <Style x:Key="CargaInfinitaVacio" TargetType="Border">
        <Setter Property="Padding" Value="24,40" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 16" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource UseSurfaceWhite}, Dark={StaticResource UseSurfaceWhite_Dark}}" />
    </Style>
    <Style x:Key="CargaInfinitaVacioTitulo" TargetType="Label">
        <Setter Property="FontFamily" Value="RobotoBold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="LineHeight" Value="1.3" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UseTextPrimary}, Dark={StaticResource UseTextPrimary_Dark}}" />
    </Style>
    <Style x:Key="CargaInfinitaVacioDescripcion" TargetType="Label">
        <Setter Property="FontFamily" Value="RobotoRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="1.5" />
        <Setter Property="HorizontalTextAlignment" Value="Center" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource UseTextTertiary}, Dark={StaticResource UseTextTertiary_Dark}}" />
    </Style>
</ResourceDictionary>
